<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HeatSync-ArrowFix</AssemblyName>
    <RootNamespace>HeatSyncArrowFix</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>heatsync.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1685</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.4.0" />
    <ProjectReference Include="..\HeatSyncFix\HeatSyncFix.csproj" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
